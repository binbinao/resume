---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import About from '../../components/About.astro';
import Highlights from '../../components/Highlights.astro';
import Timeline from '../../components/Timeline.astro';
import Projects from '../../components/Projects.astro';
import Skills from '../../components/Skills.astro';
import EducationAndLanguages from '../../components/EducationAndLanguages.astro';
import Contact from '../../components/Contact.astro';
import { pickDict } from '../../i18n';

const t = pickDict('zh', 'caio');
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const profile = 'caio';
---

<BaseLayout
  title={t.meta.title}
  description={t.meta.description}
  locale="zh"
  pathPrefix="/caio"
  profile="caio"
  showLang={false}
>
  <div class="border-b border-slate-200/70 bg-accent-50/60 text-center text-xs dark:border-slate-800 dark:bg-accent-950/20">
    <div class="container-prose flex flex-wrap items-center justify-center gap-x-3 gap-y-1 py-2">
      <span class="font-semibold text-slate-500 dark:text-slate-400">简历版本：</span>
      <a href={`${base}/`} class="link-soft">工业 AI 架构师（主）</a>
      <span class="text-slate-300">·</span>
      <a href={`${base}/cio/`} class="link-soft">CIO 版</a>
      <span class="text-slate-300">·</span>
      <span class="font-semibold text-accent-700 dark:text-accent-300">CAIO 版</span>
    </div>
  </div>

  <Hero locale="zh" profile="caio" />
  <About locale="zh" profile="caio" />
  <Highlights locale="zh" profile="caio" />
  <Timeline locale="zh" profile="caio" />
  <Projects locale="zh" />
  <Skills locale="zh" profile="caio" />
  <EducationAndLanguages locale="zh" />
  <Contact locale="zh" />
</BaseLayout>
