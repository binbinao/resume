---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import About from '../../components/About.astro';
import Highlights from '../../components/Highlights.astro';
import Timeline from '../../components/Timeline.astro';
import Projects from '../../components/Projects.astro';
import Skills from '../../components/Skills.astro';
import EducationAndLanguages from '../../components/EducationAndLanguages.astro';
import Contact from '../../components/Contact.astro';
import { pickDict } from '../../i18n';

const t = pickDict('zh', 'caio');
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const profile = 'caio';
---

<BaseLayout
  title={t.meta.title}
  description={t.meta.description}
  locale="zh"
  pathPrefix="/caio"
  profile="caio"
>
  <Hero locale="zh" profile="caio" />
  <About locale="zh" profile="caio" />
  <Highlights locale="zh" profile="caio" />
  <Timeline locale="zh" profile="caio" />
  <Projects locale="zh" />
  <Skills locale="zh" profile="caio" />
  <EducationAndLanguages locale="zh" />
  <Contact locale="zh" />
</BaseLayout>
