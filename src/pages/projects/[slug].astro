---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, type CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const { Content } = await project.render();
const { data } = project;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<BaseLayout
  title={`${data.name} — Robin Ji`}
  description={data.tagline}
  locale="zh"
  pathPrefix=""
>
  <article class="container-prose py-16">
    <a href={`${base}/`} class="link-soft text-sm">← 返回主页</a>
    <header class="mt-8 border-b border-slate-200 pb-10 dark:border-slate-800">
      <p class="font-mono text-sm text-slate-500 dark:text-slate-400">{data.period} · {data.role}</p>
      <h1 class="mt-3 text-4xl font-bold tracking-tight sm:text-5xl">{data.name}</h1>
      <p class="mt-4 max-w-2xl text-lg leading-relaxed text-slate-700 dark:text-slate-300">{data.tagline}</p>
      <div class="mt-6 flex flex-wrap gap-1.5">
        {data.metrics.map((m) => (
          <span class="pill">
            <strong class="mr-1 font-semibold">{m.value}</strong>
            <span class="text-slate-500 dark:text-slate-400">{m.label}</span>
          </span>
        ))}
      </div>
      {data.repo && (
        <a href={data.repo} rel="noopener" target="_blank" class="mt-6 inline-flex items-center gap-2 rounded-full border border-slate-300 px-4 py-2 text-sm font-medium text-slate-700 transition-colors hover:border-accent-500 hover:text-accent-700 dark:border-slate-700 dark:text-slate-300">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.11.79-.25.79-.55v-2c-3.2.7-3.87-1.36-3.87-1.36-.52-1.33-1.28-1.69-1.28-1.69-1.05-.71.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.74.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.29 1.18-3.09-.12-.29-.51-1.46.11-3.04 0 0 .96-.31 3.16 1.18a10.9 10.9 0 0 1 5.76 0c2.2-1.49 3.16-1.18 3.16-1.18.62 1.58.23 2.75.11 3.04.74.8 1.18 1.83 1.18 3.09 0 4.42-2.7 5.39-5.27 5.68.41.35.78 1.04.78 2.1v3.11c0 .3.21.66.8.55A11.5 11.5 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5z"/>
          </svg>
          访问仓库 →
        </a>
      )}
    </header>

    <div class="prose prose-slate mt-10 max-w-none dark:prose-invert prose-headings:tracking-tight prose-li:my-1">
      <Content />
    </div>

    <footer class="mt-12 border-t border-slate-200 pt-8 text-sm text-slate-500 dark:border-slate-800 dark:text-slate-400">
      <a href={`${base}/`} class="link-soft">← 返回主页</a>
    </footer>
  </article>
</BaseLayout>