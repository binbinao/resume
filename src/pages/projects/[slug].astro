---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, type CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const { Content } = await project.render();
const { data } = project;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<BaseLayout
  title={`${data.name} — Robin Ji`}
  description={data.tagline}
  locale="zh"
  pathPrefix=""
>
  <article class="container-prose py-12 sm:py-16">
    <a href={`${base}/`} class="link-soft inline-flex items-center gap-2 text-sm font-semibold">
      <span aria-hidden="true">←</span> {data.backLabel || '返回主页'}
    </a>

    <header class="mt-10 border-b border-slate-200 pb-10 dark:border-slate-800">
      <p class="font-mono text-xs uppercase tracking-[0.18em] text-accent-700 dark:text-accent-400">{data.period} · {data.role}</p>
      <h1 class="mt-3 text-4xl font-semibold tracking-[-0.035em] sm:text-5xl">{data.name}</h1>
      <p class="reading-width mt-5 text-pretty text-lg leading-relaxed text-slate-700 dark:text-slate-300">{data.tagline}</p>

      <div class="mt-6 flex flex-wrap gap-2">
        {data.metrics.map((metric) => (
          <span class="pill">
            <strong class="mr-1 font-semibold text-slate-900 dark:text-slate-100">{metric.value}</strong>
            <span class="text-slate-500 dark:text-slate-400">{metric.label}</span>
          </span>
        ))}
      </div>

      <div class="mt-7 flex flex-wrap gap-3">
        {data.repo && (
          <a href={data.repo} rel="noopener noreferrer" target="_blank" class="button-secondary">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.11.79-.25.79-.55v-2c-3.2.7-3.87-1.36-3.87-1.36-.52-1.33-1.28-1.69-1.28-1.69-1.05-.71.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.74.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.29 1.18-3.09-.12-.29-.51-1.46.11-3.04 0 0 .96-.31 3.16 1.18a10.9 10.9 0 0 1 5.76 0c2.2-1.49 3.16-1.18 3.16-1.18.62 1.58.23 2.75.11 3.04.74.8 1.18 1.83 1.18 3.09 0 4.42-2.7 5.39-5.27 5.68.41.35.78 1.04.78 2.1v3.11c0 .3.21.66.8.55A11.5 11.5 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5z"/>
            </svg>
            访问仓库 <span aria-hidden="true">↗</span>
          </a>
        )}
        <a href={`${base}/#projects`} class="button-secondary">其他项目</a>
      </div>
    </header>

    <div class="prose prose-slate reading-width mt-12 max-w-none dark:prose-invert prose-headings:tracking-tight prose-li:my-1 prose-h2:border-b prose-h2:border-slate-200 prose-h2:pb-2 prose-h2:text-xl dark:prose-h2:border-slate-800">
      <Content />
    </div>

    <footer class="mt-16 flex flex-wrap items-center justify-between gap-4 border-t border-slate-200 pt-8 text-sm text-slate-500 dark:border-slate-800 dark:text-slate-400">
      <a href={`${base}/`} class="link-soft inline-flex items-center gap-2 font-semibold">
        <span aria-hidden="true">←</span> {data.backLabel || '返回主页'}
      </a>
      <a href={`${base}/#contact`} class="link-soft font-semibold">联系我</a>
    </footer>
  </article>
</BaseLayout>
