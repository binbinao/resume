---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Hero from '../../../components/Hero.astro';
import About from '../../../components/About.astro';
import Highlights from '../../../components/Highlights.astro';
import Timeline from '../../../components/Timeline.astro';
import Projects from '../../../components/Projects.astro';
import Skills from '../../../components/Skills.astro';
import EducationAndLanguages from '../../../components/EducationAndLanguages.astro';
import Contact from '../../../components/Contact.astro';
import { pickDict } from '../../../i18n';

const t = pickDict('en', 'cio');
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const profile = 'cio';
---

<BaseLayout
  title={t.meta.title}
  description={t.meta.description}
  locale="en"
  pathPrefix="/cio/en"
  profile="cio"
>
  <Hero locale="en" profile="cio" />
  <About locale="en" profile="cio" />
  <Highlights locale="en" profile="cio" />
  <Timeline locale="en" profile="cio" />
  <Projects locale="en" />
  <Skills locale="en" profile="cio" />
  <EducationAndLanguages locale="en" />
  <Contact locale="en" />
</BaseLayout>
