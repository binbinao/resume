---
import { pickDict, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = pickDict(locale);
---

<section id="experience" class="section border-t border-slate-200 dark:border-slate-800">
  <div class="container-prose">
    <p class="section-eyebrow">{t.experience.title}</p>
    <h2 class="section-title text-balance">{t.experience.headline}</h2>
    <ol class="relative mt-12 space-y-12 border-l border-slate-200 pl-8 dark:border-slate-800">
      {t.experience.sections.map((entry) => (
        <li class="relative">
          <span class="timeline-node" aria-hidden="true"></span>
          <div class="flex flex-wrap items-baseline gap-x-4 gap-y-1">
            <span class="pill font-mono">{entry.period}</span>
            <span class="text-sm text-slate-500 dark:text-slate-400">{entry.location}</span>
          </div>
          <h3 class="mt-3 text-xl font-semibold tracking-tight">{entry.company}</h3>
          <p class="mt-1 text-base font-medium text-accent-700 dark:text-accent-400">{entry.role}</p>
          <ul class="mt-4 space-y-2 text-[15px] leading-relaxed text-slate-700 dark:text-slate-300">
            {entry.bullets.map((b) => (
              <li class="text-pretty"><span class="mr-2 text-accent-500">▸</span>{b}</li>
            ))}
          </ul>
        </li>
      ))}
    </ol>
  </div>
</section>