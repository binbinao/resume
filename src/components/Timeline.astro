---
import { pickDict, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = pickDict(locale);
---

<section id="experience" class="section border-t border-slate-200/80 dark:border-slate-800">
  <div class="container-prose">
    <p class="section-eyebrow">{t.experience.title}</p>
    <h2 class="section-title text-balance">{t.experience.headline}</h2>

    <ol class="mt-12 divide-y divide-slate-200 border-y border-slate-200 dark:divide-slate-800 dark:border-slate-800">
      {t.experience.sections.map((entry, index) => (
        <li class="grid gap-5 py-9 md:grid-cols-[10rem_minmax(0,1fr)] md:gap-10 lg:grid-cols-[12rem_minmax(0,1fr)] lg:py-12">
          <div>
            <span class="font-mono text-xs font-semibold text-accent-700 dark:text-accent-400">{entry.period}</span>
            <p class="mt-2 text-xs uppercase tracking-[0.14em] text-slate-400 dark:text-slate-500">{entry.location}</p>
            <span class="mt-5 hidden font-mono text-[10px] text-slate-300 md:block dark:text-slate-700">0{index + 1}</span>
          </div>

          <article class="max-w-4xl">
            <h3 class="text-xl font-semibold tracking-tight sm:text-2xl">{entry.company}</h3>
            <p class="mt-2 text-sm font-semibold text-accent-700 dark:text-accent-400">{entry.role}</p>
            <ul class="mt-6 list-disc space-y-3 pl-5 text-[15px] leading-relaxed text-slate-700 marker:text-accent-500 dark:text-slate-300">
              {entry.bullets.map((bullet) => (
                <li class="text-pretty pl-1">{bullet}</li>
              ))}
            </ul>
          </article>
        </li>
      ))}
    </ol>
  </div>
</section>
