---
import { pickDict, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = pickDict(locale);
---

<section id="highlights" class="section border-t border-slate-200 dark:border-slate-800">
  <div class="container-prose">
    <p class="section-eyebrow">{t.highlights.title}</p>
    <h2 class="section-title text-balance">用数字说话。</h2>
    <div class="mt-10 grid gap-6 sm:grid-cols-2">
      {t.highlights.items.map((item) => (
        <article class="card flex flex-col gap-3">
          <div class="flex items-baseline gap-3">
            <span class="text-4xl font-bold tracking-tight text-accent-700 dark:text-accent-400">{item.metric}</span>
            <span class="text-sm font-medium text-slate-500 dark:text-slate-400">{item.label}</span>
          </div>
          <p class="text-pretty text-sm leading-relaxed text-slate-600 dark:text-slate-400">{item.sub}</p>
        </article>
      ))}
    </div>
  </div>
</section>