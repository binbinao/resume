---
import { pickDict, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = pickDict(locale);
---

<section id="highlights" class="section border-t border-slate-200/80 dark:border-slate-800">
  <div class="container-prose">
    <p class="section-eyebrow">{t.highlights.title}</p>
    <div class="flex flex-col justify-between gap-4 lg:flex-row lg:items-end">
      <h2 class="section-title text-balance">{t.highlights.headline}</h2>
      <p class="font-mono text-xs uppercase tracking-[0.16em] text-slate-400 dark:text-slate-500">Evidence over adjectives</p>
    </div>

    <div class="mt-10 grid overflow-hidden rounded-3xl border border-slate-200 bg-white/70 shadow-sm shadow-slate-900/[0.03] sm:grid-cols-2 lg:grid-cols-4 dark:border-slate-800 dark:bg-slate-900/55 dark:shadow-black/10">
      {t.highlights.items.map((item, index) => (
        <article class:list={[
          "relative min-w-0 p-6 sm:p-7",
          index > 0 && "border-t border-slate-200 sm:border-t-0 dark:border-slate-800",
          index % 2 === 1 && "sm:border-l sm:border-slate-200 sm:dark:border-slate-800",
          index >= 2 && "sm:border-t sm:border-slate-200 sm:dark:border-slate-800 lg:border-t-0",
          index > 0 && "lg:border-l lg:border-slate-200 lg:dark:border-slate-800",
        ]}>
          <span class="absolute right-5 top-5 font-mono text-[10px] font-semibold text-slate-300 dark:text-slate-600">0{index + 1}</span>
          <p class="whitespace-nowrap text-3xl font-semibold tracking-[-0.04em] text-accent-700 sm:text-4xl dark:text-accent-400">{item.metric}</p>
          <h3 class="mt-3 min-h-10 text-sm font-semibold leading-snug text-slate-900 dark:text-slate-100">{item.label}</h3>
          <p class="mt-4 text-pretty text-sm leading-relaxed text-slate-600 dark:text-slate-400">{item.sub}</p>
        </article>
      ))}
    </div>
  </div>
</section>
