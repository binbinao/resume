---
import { pickDict, type Locale } from '../i18n';

interface Props {
  locale: Locale;
  otherLocaleHref: string;
  pathPrefix?: string;
}

const { locale, otherLocaleHref, pathPrefix = '' } = Astro.props;
const t = pickDict(locale);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const links = [
  { href: `${base}${pathPrefix}#about`, label: t.nav.about },
  { href: `${base}${pathPrefix}#highlights`, label: t.nav.highlights },
  { href: `${base}${pathPrefix}#experience`, label: t.nav.experience },
  { href: `${base}${pathPrefix}#projects`, label: t.nav.projects },
  { href: `${base}${pathPrefix}#skills`, label: t.nav.skills },
  { href: `${base}${pathPrefix}#contact`, label: t.nav.contact },
];
---

<header class="sticky top-0 z-40 border-b border-slate-200/70 bg-[#f6f8fc]/85 backdrop-blur-xl dark:border-slate-800/80 dark:bg-[#0b1018]/85">
  <nav class="container-prose flex h-16 items-center justify-between" aria-label={locale === 'en' ? 'Primary navigation' : '主导航'}>
    <a href={`${base}${pathPrefix}`} class="group flex items-center gap-3 rounded-lg font-semibold tracking-tight" aria-label="Robin Ji home">
      <span class="grid h-9 w-9 place-items-center rounded-xl bg-gradient-to-br from-accent-600 to-accent-800 text-sm font-bold text-white shadow-sm shadow-accent-900/20 transition-transform duration-200 group-hover:-rotate-3 dark:from-accent-400 dark:to-accent-600 dark:text-slate-950">RJ</span>
      <span class="hidden sm:block">
        <span class="block text-sm leading-none text-slate-950 dark:text-white">Robin Ji</span>
        <span class="mt-1 block text-[10px] font-semibold uppercase tracking-[0.16em] text-slate-500 dark:text-slate-400">Industrial AI</span>
      </span>
    </a>

    <ul class="hidden items-center gap-1 text-sm font-medium text-slate-600 md:flex dark:text-slate-300">
      {links.map((link) => (
        <li>
          <a href={link.href} class="block rounded-full px-3 py-2 transition-colors hover:bg-white hover:text-accent-700 dark:hover:bg-slate-900 dark:hover:text-accent-300">{link.label}</a>
        </li>
      ))}
    </ul>

    <div class="flex items-center gap-2">
      <button
        type="button"
        class="icon-button"
        data-theme-toggle
        data-label-light={t.nav.themeToLight}
        data-label-dark={t.nav.themeToDark}
        aria-label={t.nav.themeToDark}
        aria-pressed="false"
      >
        <svg data-theme-icon-moon width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M21 12.8A9 9 0 1 1 11.2 3 7 7 0 0 0 21 12.8Z" />
        </svg>
        <svg data-theme-icon-sun class="hidden" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.93 4.93l1.42 1.42M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.42-1.42M17.66 6.34l1.41-1.41" />
        </svg>
      </button>

      <a
        href={otherLocaleHref}
        class="grid min-h-9 min-w-9 place-items-center rounded-full border border-slate-300 bg-white/70 px-3 text-xs font-bold text-slate-700 transition-colors hover:border-accent-400 hover:text-accent-700 dark:border-slate-700 dark:bg-slate-900/70 dark:text-slate-300 dark:hover:border-accent-500 dark:hover:text-accent-300"
        aria-label={locale === 'en' ? '切换到中文' : 'Switch to English'}
      >
        {t.nav.switchLang}
      </a>

      <details class="group relative md:hidden">
        <summary class="icon-button cursor-pointer list-none [&::-webkit-details-marker]:hidden" aria-label={t.nav.menu}>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M4 7h16M4 12h16M4 17h16" />
          </svg>
        </summary>
        <div class="absolute right-0 top-12 w-48 rounded-2xl border border-slate-200 bg-white p-2 shadow-xl shadow-slate-900/10 dark:border-slate-800 dark:bg-slate-900 dark:shadow-black/30">
          <ul class="space-y-1 text-sm font-medium text-slate-700 dark:text-slate-200">
            {links.map((link) => (
              <li><a href={link.href} class="block rounded-xl px-4 py-3 hover:bg-slate-100 hover:text-accent-700 dark:hover:bg-slate-800 dark:hover:text-accent-300">{link.label}</a></li>
            ))}
          </ul>
        </div>
      </details>
    </div>
  </nav>
</header>
