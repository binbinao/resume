---
import { pickDict, type Locale } from '../i18n';

interface Props {
  locale: Locale;
  otherLocaleHref: string;
  pathPrefix?: string;
}

const { locale, otherLocaleHref, pathPrefix = '' } = Astro.props;
const t = pickDict(locale);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const links = [
  { href: `${base}${pathPrefix}#about`, label: t.nav.about },
  { href: `${base}${pathPrefix}#highlights`, label: t.nav.highlights },
  { href: `${base}${pathPrefix}#experience`, label: t.nav.experience },
  { href: `${base}${pathPrefix}#projects`, label: t.nav.projects },
  { href: `${base}${pathPrefix}#skills`, label: t.nav.skills },
  { href: `${base}${pathPrefix}#contact`, label: t.nav.contact },
];
---

<header class="sticky top-0 z-40 border-b border-slate-200/60 bg-slate-50/80 backdrop-blur dark:border-slate-800/60 dark:bg-slate-950/80">
  <nav class="container-prose flex items-center justify-between py-4">
    <a href={`${base}${pathPrefix}`} class="flex items-center gap-2 font-semibold tracking-tight">
      <span class="grid h-8 w-8 place-items-center rounded-lg bg-accent-700 text-sm font-bold text-white">R</span>
      <span class="hidden sm:inline">Robin Ji</span>
    </a>
    <ul class="hidden items-center gap-7 text-sm font-medium text-slate-700 md:flex dark:text-slate-300">
      {links.map((l) => (
        <li>
          <a href={l.href} class="transition-colors hover:text-accent-600 dark:hover:text-accent-400">{l.label}</a>
        </li>
      ))}
    </ul>
    <div class="flex items-center gap-3">
      <a
        href={otherLocaleHref}
        class="rounded-full border border-slate-300 px-3 py-1 text-xs font-semibold text-slate-700 transition-colors hover:border-accent-500 hover:text-accent-600 dark:border-slate-700 dark:text-slate-300 dark:hover:border-accent-400 dark:hover:text-accent-400"
        aria-label="Switch language"
      >
        {t.nav.switchLang}
      </a>
    </div>
  </nav>
</header>