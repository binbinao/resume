---
interface Props {
  copy: string;
}

const { copy } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="border-t border-slate-200 bg-slate-100/50 py-10 dark:border-slate-800 dark:bg-slate-900/40">
  <div class="container-prose flex flex-col items-start justify-between gap-4 text-sm text-slate-500 sm:flex-row sm:items-center dark:text-slate-400">
    <p>© {year} Robin Ji · {copy}</p>
    <p class="font-mono text-xs">Astro · Tailwind · Static · GitHub Pages</p>
  </div>
</footer>