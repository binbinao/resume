---
import { pickDict, type Locale } from '../i18n';

interface Props {
  copy: string;
  locale: Locale;
}

const { copy, locale } = Astro.props;
const t = pickDict(locale);
const year = new Date().getFullYear();
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const isEn = locale === 'en';
---

<footer class="border-t border-slate-200/80 bg-white/60 py-12 dark:border-slate-800 dark:bg-slate-950/40">
  <div class="container-prose flex flex-col gap-6 text-sm text-slate-500 sm:flex-row sm:items-center sm:justify-between dark:text-slate-400">
    <div>
      <p class="font-semibold text-slate-900 dark:text-slate-100">© {year} Robin Ji · 纪多斌</p>
      <p class="mt-1 text-xs">{copy}</p>
    </div>
    <ul class="flex flex-wrap items-center gap-x-5 gap-y-2 text-xs font-semibold uppercase tracking-[0.14em]">
      <li><a href="https://github.com/binbinao" rel="noopener noreferrer" target="_blank" class="link-soft">GitHub</a></li>
      <li><a href="https://www.youtube.com/@binbinao" rel="noopener noreferrer" target="_blank" class="link-soft">YouTube</a></li>
      <li><a href={`${base}${isEn ? '/' : '/en/'}`} class="link-soft">{isEn ? 'View in 中文' : 'View in EN'}</a></li>
    </ul>
    <p class="font-mono text-[10px] uppercase tracking-[0.14em] text-slate-400 dark:text-slate-500">Astro · Tailwind · Static · GitHub Pages</p>
  </div>
</footer>
