---
import { pickDict, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = pickDict(locale);
---

<section id="about" class="section">
  <div class="container-prose">
    <p class="section-eyebrow">{t.about.title}</p>
    <h2 class="section-title text-balance">{t.about.headline}</h2>
    <div class="mt-8 space-y-5 text-lg leading-relaxed text-slate-700 dark:text-slate-300">
      {t.about.body.map((para) => (
        <p class="text-pretty">{para}</p>
      ))}
    </div>
  </div>
</section>