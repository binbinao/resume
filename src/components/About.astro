---
import { pickDict, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = pickDict(locale);
---

<section id="about" class="section">
  <div class="container-prose grid gap-10 lg:grid-cols-[0.72fr_1.28fr] lg:gap-20">
    <header>
      <p class="section-eyebrow">{t.about.title}</p>
      <h2 class="section-title text-balance">{t.about.headline}</h2>
      <p class="mt-6 font-mono text-xs uppercase tracking-[0.16em] text-slate-400 dark:text-slate-500">
        Industrial software → Cloud → AI
      </p>
    </header>
    <div class="reading-width space-y-6 border-l border-slate-200 pl-6 text-lg leading-relaxed text-slate-700 sm:pl-10 dark:border-slate-800 dark:text-slate-300">
      {t.about.body.map((paragraph, index) => (
        <p class:list={["text-pretty", index === 0 && "text-xl font-medium leading-relaxed text-slate-900 dark:text-slate-100"]}>{paragraph}</p>
      ))}
    </div>
  </div>
</section>
