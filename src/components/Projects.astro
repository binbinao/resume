---
import { getCollection } from 'astro:content';
import ProjectCard from './ProjectCard.astro';
import { pickDict, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = pickDict(locale);

const projects = (await getCollection('projects', ({ data }) => data.featured))
  .sort((a, b) => a.data.order - b.data.order);
---

<section id="projects" class="section border-t border-slate-200 dark:border-slate-800">
  <div class="container-prose">
    <p class="section-eyebrow">{t.projects.title}</p>
    <h2 class="section-title text-balance">{t.projects.subtitle}</h2>
    <div class="mt-10 grid gap-6 sm:grid-cols-2">
      {projects.map((p) => (
        <ProjectCard project={p} locale={locale} />
      ))}
    </div>
  </div>
</section>