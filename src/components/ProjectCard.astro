---
import type { CollectionEntry } from 'astro:content';
import { pickDict, type Locale } from '../i18n';

interface Props {
  project: CollectionEntry<'projects'>;
  locale: Locale;
  layout?: 'wide' | 'standard';
}

const { project, locale, layout = 'standard' } = Astro.props;
const t = pickDict(locale);
const { data } = project;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const isEn = locale === 'en';
const tagline = isEn ? (data.taglineEn ?? data.tagline) : data.tagline;
const role = isEn ? (data.roleEn ?? data.role) : data.role;
const stack = isEn ? (data.stackEn ?? data.stack) : data.stack;
const metrics = isEn && data.metricsEn ? data.metricsEn : data.metrics;
const highlights = isEn && data.highlightsEn ? data.highlightsEn : data.highlights;
const layoutClass = layout === 'wide' ? 'lg:col-span-3' : 'lg:col-span-2';
---

<article class:list={["card group flex h-full min-w-0 flex-col gap-5", layoutClass]}>
  <header class="flex items-start justify-between gap-4">
    <div class="min-w-0">
      <h3 class="break-words text-xl font-semibold tracking-tight sm:text-2xl">{data.name}</h3>
      <p class="mt-2 text-pretty text-sm leading-relaxed text-slate-600 dark:text-slate-400">{tagline}</p>
    </div>
    {data.repo && (
      <a
        href={data.repo}
        rel="noopener noreferrer"
        target="_blank"
        class="grid h-9 w-9 shrink-0 place-items-center rounded-full border border-slate-200 text-slate-400 transition-colors hover:border-accent-400 hover:text-accent-700 dark:border-slate-700 dark:hover:border-accent-600 dark:hover:text-accent-300"
        aria-label={`${data.name} GitHub repo`}
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.11.79-.25.79-.55v-2c-3.2.7-3.87-1.36-3.87-1.36-.52-1.33-1.28-1.69-1.28-1.69-1.05-.71.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.74.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.29 1.18-3.09-.12-.29-.51-1.46.11-3.04 0 0 .96-.31 3.16 1.18a10.9 10.9 0 0 1 5.76 0c2.2-1.49 3.16-1.18 3.16-1.18.62 1.58.23 2.75.11 3.04.74.8 1.18 1.83 1.18 3.09 0 4.42-2.7 5.39-5.27 5.68.41.35.78 1.04.78 2.1v3.11c0 .3.21.66.8.55A11.5 11.5 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5z"/>
        </svg>
      </a>
    )}
  </header>

  <div class="flex flex-wrap gap-2">
    {metrics.map((metric) => (
      <span class="pill">
        <strong class="mr-1 font-semibold text-slate-900 dark:text-slate-100">{metric.value}</strong>
        <span class="text-slate-500 dark:text-slate-400">{metric.label}</span>
      </span>
    ))}
  </div>

  <ul class="list-disc space-y-2 pl-5 text-sm leading-relaxed text-slate-700 marker:text-accent-500 dark:text-slate-300">
    {highlights.slice(0, 4).map((highlight) => (
      <li class="text-pretty pl-1">{highlight}</li>
    ))}
  </ul>

  <div class="mt-auto flex flex-wrap gap-2 border-t border-slate-200/80 pt-5 dark:border-slate-800">
    {stack.map((item) => (
      <span class="rounded-md bg-slate-100 px-2 py-1 font-mono text-[10px] font-medium text-slate-600 dark:bg-slate-800 dark:text-slate-300">{item}</span>
    ))}
  </div>

  <footer class="flex items-end justify-between gap-4 text-xs text-slate-500 dark:text-slate-400">
    <span class="leading-relaxed">{role}<br />{data.period}</span>
    <a href={`${base}/projects/${project.slug}/`} class="link-soft shrink-0 font-semibold" aria-label={`${t.projects.viewDetail}: ${data.name}`}>
      {t.projects.viewDetail} <span aria-hidden="true" class="inline-block transition-transform duration-200 group-hover:translate-x-1">→</span>
    </a>
  </footer>
</article>
