---
import type { CollectionEntry } from 'astro:content';
import { pickDict, type Locale } from '../i18n';

interface Props {
  project: CollectionEntry<'projects'>;
  locale: Locale;
}

const { project, locale } = Astro.props;
const t = pickDict(locale);
const { data } = project;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<article class="card flex h-full flex-col gap-4">
  <header class="flex items-start justify-between gap-4">
    <div>
      <h3 class="text-xl font-semibold tracking-tight">{data.name}</h3>
      <p class="mt-1 text-pretty text-sm leading-relaxed text-slate-600 dark:text-slate-400">{data.tagline}</p>
    </div>
    {data.repo && (
      <a
        href={data.repo}
        rel="noopener"
        target="_blank"
        class="shrink-0 text-slate-400 transition-colors hover:text-accent-600 dark:hover:text-accent-400"
        aria-label={`${data.name} GitHub repo`}
      >
        <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.11.79-.25.79-.55v-2c-3.2.7-3.87-1.36-3.87-1.36-.52-1.33-1.28-1.69-1.28-1.69-1.05-.71.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.74.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.29 1.18-3.09-.12-.29-.51-1.46.11-3.04 0 0 .96-.31 3.16 1.18a10.9 10.9 0 0 1 5.76 0c2.2-1.49 3.16-1.18 3.16-1.18.62 1.58.23 2.75.11 3.04.74.8 1.18 1.83 1.18 3.09 0 4.42-2.7 5.39-5.27 5.68.41.35.78 1.04.78 2.1v3.11c0 .3.21.66.8.55A11.5 11.5 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5z"/>
        </svg>
      </a>
    )}
  </header>

  <div class="flex flex-wrap gap-1.5">
    {data.metrics.map((m) => (
      <span class="pill">
        <strong class="mr-1 font-semibold">{m.value}</strong>
        <span class="text-slate-500 dark:text-slate-400">{m.label}</span>
      </span>
    ))}
  </div>

  <ul class="space-y-1.5 text-sm leading-relaxed text-slate-700 dark:text-slate-300">
    {data.highlights.slice(0, 4).map((h) => (
      <li class="text-pretty"><span class="mr-2 text-accent-500">▸</span>{h}</li>
    ))}
  </ul>

  <div class="mt-auto flex flex-wrap gap-1.5 border-t border-slate-100 pt-4 dark:border-slate-800">
    {data.stack.map((s) => (
      <span class="pill font-mono text-[11px]">{s}</span>
    ))}
  </div>

  <footer class="flex items-center justify-between text-xs text-slate-500 dark:text-slate-400">
    <span>{data.role} · {data.period}</span>
    {data.repo && (
      <a href={`${base}/projects/${project.slug}/`} class="link-soft font-medium">{t.projects.viewDetail} →</a>
    )}
  </footer>
</article>