---
import { pickDict, type Locale } from '../i18n';

interface Props {
  locale: Locale;
  pathPrefix?: string;
  profile?: 'cio' | 'caio';
}

const { locale, pathPrefix = '', profile } = Astro.props;
const t = pickDict(locale, profile);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const defaultSteps = locale === 'en'
  ? [
      { index: '01', title: 'Industrial software', sub: 'CAD · CAE · PLM · MES' },
      { index: '02', title: 'Cloud & HPC', sub: 'Simulation cloud · GPU systems' },
      { index: '03', title: 'Industrial AI', sub: 'AI for Engineering · Agents' },
    ]
  : [
      { index: '01', title: '工业软件', sub: 'CAD · CAE · PLM · MES' },
      { index: '02', title: '云与高性能计算', sub: '仿真云 · GPU 系统' },
      { index: '03', title: '工业 AI', sub: 'AI for Engineering · Agents' },
    ];
const pathSteps = (t.hero as { pathSteps?: typeof defaultSteps }).pathSteps ?? defaultSteps;
---

<section class="relative isolate overflow-hidden border-b border-slate-200/80 dark:border-slate-800">
  <div class="surface-grid absolute inset-0 -z-20"></div>
  <div class="absolute -right-32 -top-48 -z-10 h-[32rem] w-[32rem] rounded-full bg-accent-300/25 blur-3xl dark:bg-accent-700/20"></div>
  <div class="absolute -bottom-48 left-1/3 -z-10 h-96 w-96 rounded-full bg-cyan-200/20 blur-3xl dark:bg-cyan-900/10"></div>

  <div class="container-prose grid min-h-[calc(100svh-4rem)] items-center gap-14 py-16 lg:grid-cols-[1.2fr_0.8fr] lg:py-20">
    <div>
      <p class="section-eyebrow">{t.hero.eyebrow}</p>
      <h1 class="max-w-4xl text-balance text-5xl font-semibold leading-[0.98] tracking-[-0.045em] sm:text-7xl lg:text-8xl">
        {t.hero.name}
      </h1>
      <p class="mt-4 text-xl font-medium tracking-tight text-slate-500 sm:text-2xl dark:text-slate-400">{t.hero.nameCN}</p>
      <p class="reading-width mt-8 text-pretty text-lg leading-relaxed text-slate-700 sm:text-xl dark:text-slate-300">
        {t.hero.tagline}
      </p>

      <div class="mt-7 flex flex-wrap items-center gap-3 text-sm text-slate-600 dark:text-slate-400">
        <span class="inline-flex min-h-9 items-center gap-2 rounded-full border border-slate-200 bg-white/70 px-3 dark:border-slate-800 dark:bg-slate-900/70">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M12 21s-7-7.5-7-12a7 7 0 0 1 14 0c0 4.5-7 12-7 12z"/><circle cx="12" cy="9" r="2.5"/>
          </svg>
          {t.hero.location}
        </span>
        <a class="inline-flex min-h-9 items-center gap-2 rounded-full border border-slate-200 bg-white/70 px-3 transition-colors hover:border-accent-400 hover:text-accent-700 dark:border-slate-800 dark:bg-slate-900/70 dark:hover:border-accent-600 dark:hover:text-accent-300" href="https://github.com/binbinao" rel="noopener noreferrer" target="_blank">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.11.79-.25.79-.55v-2c-3.2.7-3.87-1.36-3.87-1.36-.52-1.33-1.28-1.69-1.28-1.69-1.05-.71.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.74.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.29 1.18-3.09-.12-.29-.51-1.46.11-3.04 0 0 .96-.31 3.16 1.18a10.9 10.9 0 0 1 5.76 0c2.2-1.49 3.16-1.18 3.16-1.18.62 1.58.23 2.75.11 3.04.74.8 1.18 1.83 1.18 3.09 0 4.42-2.7 5.39-5.27 5.68.41.35.78 1.04.78 2.1v3.11c0 .3.21.66.8.55A11.5 11.5 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5z"/></svg>
          GitHub
        </a>
        <a class="inline-flex min-h-9 items-center gap-2 rounded-full border border-slate-200 bg-white/70 px-3 transition-colors hover:border-accent-400 hover:text-accent-700 dark:border-slate-800 dark:bg-slate-900/70 dark:hover:border-accent-600 dark:hover:text-accent-300" href="https://www.youtube.com/@binbinao" rel="noopener noreferrer" target="_blank">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M23.5 6.2a3 3 0 0 0-2.1-2.1C19.5 3.5 12 3.5 12 3.5s-7.5 0-9.4.6A3 3 0 0 0 .5 6.2C0 8.1 0 12 0 12s0 3.9.5 5.8a3 3 0 0 0 2.1 2.1c1.9.6 9.4.6 9.4.6s7.5 0 9.4-.6a3 3 0 0 0 2.1-2.1c.5-1.9.5-5.8.5-5.8s0-3.9-.5-5.8zM9.6 15.6V8.4l6.3 3.6-6.3 3.6z"/></svg>
          YouTube
        </a>
      </div>

      <div class="mt-10 flex flex-wrap gap-3">
        <a href={`${base}${pathPrefix}#projects`} class="button-primary">
          {t.hero.ctaPrimary}
          <span aria-hidden="true">→</span>
        </a>
        <a href={`${base}${pathPrefix}#contact`} class="button-secondary">{t.hero.ctaSecondary}</a>
      </div>
    </div>

    <aside class="relative mx-auto w-full max-w-md lg:mx-0 lg:justify-self-end" aria-label={locale === 'en' ? 'Career path' : '职业路径'}>
      <div class="absolute left-6 top-10 h-[calc(100%-5rem)] w-px bg-gradient-to-b from-accent-500 via-accent-400 to-cyan-400" aria-hidden="true"></div>
      <ol class="space-y-4">
        {pathSteps.map((step, index) => (
          <li class="relative flex gap-5 rounded-2xl border border-slate-200/80 bg-white/75 p-5 shadow-sm shadow-slate-900/[0.03] backdrop-blur transition duration-200 hover:-translate-y-0.5 hover:border-accent-300 dark:border-slate-800 dark:bg-slate-900/70 dark:hover:border-accent-700">
            <span class="relative z-10 grid h-12 w-12 shrink-0 place-items-center rounded-xl border border-accent-200 bg-accent-50 font-mono text-xs font-bold text-accent-700 dark:border-accent-800 dark:bg-accent-900/40 dark:text-accent-300">{step.index}</span>
            <div>
              <h2 class="text-base font-semibold">{step.title}</h2>
              <p class="mt-1 text-sm leading-relaxed text-slate-500 dark:text-slate-400">{step.sub}</p>
            </div>
            {index < pathSteps.length - 1 && <span class="sr-only">then</span>}
          </li>
        ))}
      </ol>
      <p class="mt-5 text-right font-mono text-[11px] uppercase tracking-[0.18em] text-slate-400 dark:text-slate-500">18+ years · 7 industries · 1 thread</p>
    </aside>
  </div>
</section>
