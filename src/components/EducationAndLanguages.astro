---
import { pickDict, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = pickDict(locale);
---

<section class="section border-t border-slate-200 dark:border-slate-800">
  <div class="container-prose grid gap-12 md:grid-cols-2">
    <div>
      <p class="section-eyebrow">{t.education.title}</p>
      <h2 class="section-title text-3xl">{t.education.items[0].degree.split(' ').slice(0, 2).join(' ')}.</h2>
      <ul class="mt-6 space-y-4">
        {t.education.items.map((e) => (
          <li class="card">
            <p class="text-base font-semibold tracking-tight">{e.school}</p>
            <p class="mt-1 text-sm text-slate-600 dark:text-slate-400">{e.degree}</p>
          </li>
        ))}
      </ul>
    </div>
    <div>
      <p class="section-eyebrow">{t.languages.title}</p>
      <h2 class="section-title text-3xl">三语可工作。</h2>
      <ul class="mt-6 space-y-3">
        {t.languages.items.map((l) => (
          <li class="card flex items-baseline justify-between gap-4">
            <span class="font-medium">{l.name}</span>
            <span class="text-sm text-slate-500 dark:text-slate-400">{l.level}</span>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>