---
import { pickDict, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = pickDict(locale);
---

<section id="skills" class="section border-t border-slate-200 dark:border-slate-800">
  <div class="container-prose">
    <p class="section-eyebrow">{t.skills.title}</p>
    <h2 class="section-title text-balance">五种能力，一条主线。</h2>
    <div class="mt-10 grid gap-6 md:grid-cols-2">
      {t.skills.groups.map((g) => (
        <article class="card">
          <h3 class="text-lg font-semibold tracking-tight">{g.heading}</h3>
          <ul class="mt-4 space-y-2 text-[15px] leading-relaxed text-slate-700 dark:text-slate-300">
            {g.items.map((i) => (
              <li class="text-pretty"><span class="mr-2 text-accent-500">▸</span>{i}</li>
            ))}
          </ul>
        </article>
      ))}
    </div>
  </div>
</section>