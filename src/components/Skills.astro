---
import { pickDict, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = pickDict(locale);
---

<section id="skills" class="section border-t border-slate-200/80 dark:border-slate-800">
  <div class="container-prose">
    <p class="section-eyebrow">{t.skills.title}</p>
    <h2 class="section-title text-balance">{t.skills.headline}</h2>

    <div class="mt-12 grid gap-x-8 gap-y-10 sm:grid-cols-2 lg:grid-cols-6">
      {t.skills.groups.map((group, index) => (
        <article class:list={[
          "border-t-2 border-slate-200 pt-5 dark:border-slate-800",
          index < 2 ? "lg:col-span-3" : "lg:col-span-2",
        ]}>
          <div class="flex items-start justify-between gap-4">
            <h3 class="text-lg font-semibold tracking-tight">{group.heading}</h3>
            <span class="font-mono text-[10px] font-bold text-accent-600 dark:text-accent-400">0{index + 1}</span>
          </div>
          <ul class="mt-5 list-disc space-y-2.5 pl-5 text-[15px] leading-relaxed text-slate-700 marker:text-accent-500 dark:text-slate-300">
            {group.items.map((item) => (
              <li class="text-pretty pl-1">{item}</li>
            ))}
          </ul>
        </article>
      ))}
    </div>
  </div>
</section>
