---
import { pickDict, type Locale } from '../i18n';
import EmailObfuscated from './EmailObfuscated.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = pickDict(locale);
---

<section id="contact" class="section border-t border-slate-200 dark:border-slate-800">
  <div class="container-prose">
    <p class="section-eyebrow">{t.contact.title}</p>
    <h2 class="section-title text-balance">{t.contact.headline}</h2>
    <p class="mt-6 max-w-2xl text-lg leading-relaxed text-slate-700 dark:text-slate-300">{t.contact.body}</p>

    <div class="mt-10 grid gap-6 md:grid-cols-2">
      <div class="card flex flex-col gap-3">
        <span class="text-xs font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400">{t.contact.emailLabel}</span>
        <EmailObfuscated user="duobinji" domain="outlook.com" />
        <p class="text-xs text-slate-500 dark:text-slate-400">{t.contact.obfuscationNote}</p>
      </div>

      <ul class="space-y-3">
        {t.contact.channels.map((c) => (
          <li class="card flex items-baseline justify-between gap-4">
            <span class="text-sm font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400">{c.label}</span>
            <a href={c.url} rel="noopener" class="link-soft font-mono text-sm">{c.handle}</a>
          </li>
        ))}
      </ul>
    </div>

    <p class="mt-10 rounded-lg border border-slate-200 bg-slate-100/60 p-4 text-sm leading-relaxed text-slate-600 dark:border-slate-800 dark:bg-slate-900/60 dark:text-slate-400">
      {t.contact.note}
    </p>
  </div>
</section>