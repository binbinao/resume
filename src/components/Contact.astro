---
import { pickDict, type Locale } from '../i18n';
import EmailObfuscated from './EmailObfuscated.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = pickDict(locale);
---

<section id="contact" class="section border-t border-slate-200/80 dark:border-slate-800">
  <div class="container-prose">
    <p class="section-eyebrow">{t.contact.title}</p>
    <h2 class="section-title text-balance">{t.contact.headline}</h2>
    <p class="reading-width mt-6 text-lg leading-relaxed text-slate-700 dark:text-slate-300">{t.contact.body}</p>

    <div class="mt-10 grid gap-6 md:grid-cols-2">
      <div class="card flex flex-col gap-4 bg-gradient-to-br from-white to-accent-50/60 dark:from-slate-900 dark:to-accent-950/30">
        <span class="font-mono text-[10px] font-bold uppercase tracking-[0.18em] text-accent-700 dark:text-accent-400">01 · {t.contact.emailLabel}</span>
        <EmailObfuscated user="duobinji" domain="outlook.com" />
        <p class="text-xs text-slate-500 dark:text-slate-400">{t.contact.obfuscationNote}</p>
      </div>

      <ul class="space-y-3">
        {t.contact.channels.map((channel, index) => (
          <li class="card flex items-center justify-between gap-4">
            <span class="font-mono text-[10px] font-bold uppercase tracking-[0.18em] text-slate-500 dark:text-slate-400">0{index + 2} · {channel.label}</span>
            <a href={channel.url} rel="noopener noreferrer" target="_blank" class="link-soft font-mono text-sm font-semibold">{channel.handle} <span aria-hidden="true">↗</span></a>
          </li>
        ))}
      </ul>
    </div>

    <p class="mt-10 rounded-2xl border border-slate-200 bg-slate-100/60 p-5 text-sm leading-relaxed text-slate-600 dark:border-slate-800 dark:bg-slate-900/60 dark:text-slate-400">
      {t.contact.note}
    </p>
  </div>
</section>
